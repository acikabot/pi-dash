# A manual run of Content Bot, started by the dashboard: systemctl start content-bot@<mode>.service
# The mode (%i) is the argument the bot already understands.
[Unit]
Description=Content Bot — manual run (%i)

[Service]
Type=oneshot
User=acika
Group=acika
WorkingDirectory=/home/acika/bots/content-bot
EnvironmentFile=/home/acika/bots/content-bot/.env
ExecStart=/home/acika/bots/content-bot/venv/bin/python content_bot.py %i
StandardOutput=append:/home/acika/bots/content-bot/content_bot.log
StandardError=append:/home/acika/bots/content-bot/content_bot.log
