# Pi dashboard configuration. Copy to .env and adjust. Never commit .env.
PIDASH_SECRET_KEY=change-me-to-a-long-random-string
PIDASH_DEBUG=false
PIDASH_ALLOWED_HOSTS=localhost,127.0.0.1
PIDASH_TIME_ZONE=Europe/Skopje

# Bind address. Localhost only once Tailscale fronts it.
PIDASH_BIND=127.0.0.1:5001

# Behind an HTTPS proxy (tailscale serve): secure cookies and proxy headers.
PIDASH_PUBLIC_MODE=false

# Where the dashboard keeps things the bots read (recipients today).
PIDASH_SHARED_CONFIG_DIR=/etc/bots

# Push notifications for failures; same topic style as the updater.
PIDASH_NTFY_URL=
